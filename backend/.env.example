# ─────────────────────────────────────────────
# DebtMap Backend — Environment Variables
# Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
# Comma-separated list of extra CORS allowed origins (optional)
ALLOWED_ORIGINS=https://dept-map.vercel.app,http://localhost:3000

# ── Supabase ──────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── GitHub OAuth App ──────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret-32-chars

# ── Groq API ──────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── App Security ──────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string-in-production

# ── Scan Settings ─────────────────────────────
# Temp directory for cloning repos during scan
SCAN_TEMP_DIR=/tmp/debtmap_scans
# Max repo size in MB to allow scanning
MAX_REPO_SIZE_MB=500
